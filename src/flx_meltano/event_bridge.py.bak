"""FLX Meltano Event Bridge. This module provides integration between Meltano events and the FLX event system,
allowing seamless event propagation and handling across both platforms.
""" from __future__ import annotations import asyncio
import uuid
from datetime import UTC, datetime
from typing import TYPE_CHECKING, Any, import, structlog

from flx_core.events.event_bus import (  # Event mapping between Meltano and FLX events self._meltano_to_flx_mapping = { "job.started": "meltano.job.started", "job.completed": "meltano.job.completed", "job.failed": "meltano.job.failed", "job.cancelled": "meltano.job.cancelled", "pipeline.started": "meltano.pipeline.started", "pipeline.completed": "meltano.pipeline.completed", "pipeline.failed": "meltano.pipeline.failed", "state.updated": "meltano.state.updated", "plugin.installed": "meltano.plugin.installed", "plugin.removed": "meltano.plugin.removed", "project.initialized": "meltano.project.initialized", "project.loaded": "meltano.project.loaded", } self.logger.info("Initialized Meltano Event Bridge") async def publish_meltano_event(self, config: EventConfig, **kwargs: object) -> None: """Publish a Meltano event to the FLX event system. Args: ---- config: Event configuration containing all event parameters **kwargs: Additional event data """ try: # Map Meltano event type to FLX event type flx_event_type = self._meltano_to_flx_mapping.get( config.event_type, f"meltano.{config.event_type}", ) # Build event data event_data = { "meltano_event_type": config.event_type, "timestamp": datetime.now(UTC).isoformat(), "event_id": str(uuid.uuid4()), **kwargs, } # Add project information if config.project: event_data.update( { "project_name": config.project.name, "project_root": str(config.project.root), "environment": ( config.project.active_environment.name if config.project.active_environment else None ), }, ) # Add job information if config.job_id: event_data["job_id"] = config.job_id # Add pipeline information if config.pipeline_name: event_data["pipeline_name"] = config.pipeline_name # Add state information if config.state: event_data.update( { "state": config.state.value, "state_name": config.state.name, }, ) # Add metadata if config.metadata: event_data["metadata"] = config.metadata # Create FLX event flx_event = DomainEvent.create( event_type=flx_event_type, data=event_data, correlation_id=kwargs.get("correlation_id"), source="meltano", ) # Publish to FLX event bus await self.flx_event_bus.publish(flx_event) self.logger.debug( "Published Meltano event to FLX", meltano_event=config.event_type, flx_event=flx_event_type, job_id=config.job_id, pipeline_name=config.pipeline_name, ) except ( ValueError, TypeError, RuntimeError, OSError, ImportError, ConnectionError, TimeoutError, AttributeError, LookupError, ) as e: # ZERO TOLERANCE - Specific exception types for Meltano event publishing failures self.logger.exception( "Failed to publish Meltano event", event_type=config.event_type, error=str(e), ) raise async def subscribe_to_meltano_events(self, callback: Callable[[str, dict[str, Any]], Any], event_patterns: list[str] | None = None) -> str: """Subscribe to Meltano events via FLX event system. Args: ---- callback: Callback function to handle events event_patterns: List of event patterns to subscribe to (defaults to all meltano.*) Returns: ------- Subscription ID """ if event_patterns is None: event_patterns = ["meltano.*"] subscription_id = str(uuid.uuid4()) async def event_handler(event: DomainEvent) -> None: """Handle FLX events from Meltano.""" try: # Extract Meltano event data meltano_event_type = event.data.get("meltano_event_type", event.type) # Call the callback if asyncio.iscoroutinefunction(callback): await callback(meltano_event_type, event.data) else: callback(meltano_event_type, event.data) except ( ValueError, TypeError, RuntimeError, OSError, ImportError, ConnectionError, TimeoutError, AttributeError, LookupError, ) as e: # ZERO TOLERANCE - Specific exception types for Meltano event handler failures self.logger.exception( "Error in Meltano event handler", event_type=event.type, error=str(e), ) # Subscribe to FLX events for pattern in event_patterns: await self.flx_event_bus.subscribe(pattern, event_handler) # Store subscription self._active_subscriptions[subscription_id] = event_handler self.logger.info( "Subscribed to Meltano events", subscription_id=subscription_id, patterns=event_patterns, ) return subscription_id async def unsubscribe_from_meltano_events(self, subscription_id: str) -> bool: """Unsubscribe from Meltano events. Args: ---- subscription_id: Subscription identifier Returns: ------- True if successfully unsubscribed """ if subscription_id not in self._active_subscriptions: self.logger.warning( "Subscription not found", subscription_id=subscription_id, ) return False try: event_handler = self._active_subscriptions.pop(subscription_id) # Unsubscribe from all patterns for this handler # Note: This is a simplified implementation - in practice, you'd need # to track which patterns each subscription uses for pattern in ["meltano.*"]: await self.flx_event_bus.unsubscribe(pattern, event_handler) self.logger.info( "Unsubscribed from Meltano events", subscription_id=subscription_id, ) except ( ValueError, TypeError, RuntimeError, OSError, ImportError, ConnectionError, TimeoutError, AttributeError, LookupError, ) as e: # ZERO TOLERANCE - Specific exception types for Meltano event unsubscription failures self.logger.exception( "Failed to unsubscribe from Meltano events", subscription_id=subscription_id, error=str(e), ) return False else: return True async def publish_job_event(self, event_type: str, project: Project, job_id: str, job_state: State, **kwargs: object) -> None: """Publish a job-related event. Args: ---- event_type: Type of job event (started, completed, failed, etc.) project: Meltano project job_id: Job identifier job_state: Current job state **kwargs: Additional parameters (pipeline_name, error_message, metadata) """ # Extract kwargs pipeline_name = kwargs.get("pipeline_name") error_message = kwargs.get("error_message") metadata = kwargs.get("metadata") event_data = { "job_id": job_id, "job_state": job_state.value, "job_state_name": job_state.name, } if pipeline_name: event_data["pipeline_name"] = pipeline_name if error_message: event_data["error_message"] = error_message event_config = EventConfig( event_type=f"job.{event_type}", project=project, job_id=job_id, pipeline_name=pipeline_name, state=job_state, metadata=metadata, ) await self.publish_meltano_event(event_config, **event_data) async def publish_pipeline_event(self, event_type: str, project: Project, pipeline_name: str, **kwargs: object) -> None: """Publish a pipeline-related event. Args: ---- event_type: Type of pipeline event (started, completed, failed, etc.) project: Meltano project pipeline_name: Pipeline name **kwargs: Additional parameters (execution_id, result_data, error_message, metadata) """ # Extract kwargs execution_id = kwargs.get("execution_id") result_data = kwargs.get("result_data") error_message = kwargs.get("error_message") metadata = kwargs.get("metadata") event_data = { "pipeline_name": pipeline_name, } if execution_id: event_data["execution_id"] = execution_id if result_data: event_data["result_data"] = result_data if error_message: event_data["error_message"] = error_message event_config = EventConfig( event_type=f"pipeline.{event_type}", project=project, pipeline_name=pipeline_name, metadata=metadata, ) await self.publish_meltano_event(event_config, **event_data) async def publish_state_event(self, project: Project, state_id: str, old_state: dict[str, object] | None = None, new_state: dict[str, object] | None = None, metadata: dict[str, object] | None = None) -> None: """Publish a state-related event. Args: ---- project: Meltano project state_id: State identifier old_state: Previous state data new_state: New state data metadata: Additional metadata """ event_data = { "state_id": state_id, } if old_state is not None: event_data["old_state"] = old_state if new_state is not None: event_data["new_state"] = new_state event_config = EventConfig( event_type="state.updated", project=project, metadata=metadata, ) await self.publish_meltano_event(event_config, **event_data) async def publish_project_event(self, event_type: str, project: Project, metadata: dict[str, object] | None = None) -> None: """Publish a project-related event. Args: ---- event_type: Type of project event (initialized, loaded, etc.) project: Meltano project metadata: Additional metadata """ event_config = EventConfig( event_type=f"project.{event_type}", project=project, metadata=metadata, ) await self.publish_meltano_event(event_config) async def get_subscription_count(self) -> int: """Get the number of active subscriptions.""" return len(self._active_subscriptions) async def get_event_statistics(self) -> dict[str, object]: """Get event bridge statistics and operational metrics. Retrieves comprehensive statistics about the current state of the event bridge, including active subscription counts, event type mappings, and supported events. Returns: ------- Dictionary containing bridge operational statistics and metrics. Note: ---- Used for monitoring bridge health and subscription management. """ return { "active_subscriptions": len(self._active_subscriptions), "event_mappings": len(self._meltano_to_flx_mapping), "supported_event_types": list(self._meltano_to_flx_mapping.keys()), } async def cleanup(self) -> None: """Cleanup event bridge resources.""" self.logger.info("Cleaning up Meltano Event Bridge") # Unsubscribe from all active subscriptions subscription_ids = list(self._active_subscriptions.keys()) for subscription_id in subscription_ids: await self.unsubscribe_from_meltano_events(subscription_id) self.logger.info("Meltano Event Bridge cleanup completed")
