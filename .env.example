# FLEXT Meltano Integration Configuration
# Copy this to .env and customize for your environment

DEBUG=true
# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

MELTANO_DATABASE_URI=sqlite:////opt/meltano/.meltano/meltano.db
MELTANO_ENVIRONMENT=dev
MELTANO_LOG_LEVEL=INFO
# Meltano Configuration
MELTANO_PROJECT_ROOT=/opt/meltano

# Singer Protocol
SINGER_PYTHON_VERSION=3.13
SINGER_SDK_LOG_CONFIG=./logging.yaml
STATE_BACKEND=filesystem
STATE_DIR=/opt/meltano/state

# ETL Configuration
DEFAULT_BATCH_SIZE=10000
INCREMENTAL_REPLICATION=true
PARALLEL_STREAMS=4
STREAM_BUFFER_SIZE=65536

AUTO_INSTALL_PLUGINS=false
PLUGIN_CACHE_DIR=/opt/meltano/cache
# Plugin Management
PLUGIN_INSTALL_DIR=/opt/meltano/plugins
PLUGIN_TIMEOUT=600

BACKUP_STATE=true
# State Management
STATE_BACKEND_URI=file:///opt/meltano/state
STATE_ENCRYPTION_KEY=
STATE_RETENTION_DAYS=30

# Database Connections
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=
TRANSFORM_DATABASE_URL=

AZURE_STORAGE_ACCOUNT=
GCS_BUCKET=
S3_ACCESS_KEY_ID=
# Cloud Storage
S3_BUCKET=
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=

RETRY_ATTEMPTS=3
RETRY_DELAY=300
# Scheduling
SCHEDULER=cron
SCHEDULE_INTERVAL=daily

LOG_FORMAT=json
METRICS_PORT=9095
OPENTELEMETRY_ENABLED=false
# Monitoring & Observability
PROMETHEUS_ENABLED=true

CPU_LIMIT=2.0
EXECUTION_TIMEOUT=3600
# Pipeline Execution
MAX_PARALLEL_PIPELINES=5
MEMORY_LIMIT_MB=2048

ANOMALY_DETECTION=false
DATA_PROFILING=false
SCHEMA_VALIDATION=strict
# Data Quality
VALIDATION_ENABLED=true

ENCRYPT_STATE=false
SECRETS_BACKEND=env
VAULT_TOKEN=
# Security
VAULT_URL=
