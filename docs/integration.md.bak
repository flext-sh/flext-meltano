```

**Future dbt Integration** (Post-abstraction layer):
```python
# Target implementation after dbt programmatic API integration
from dbt.cli.main import dbtRunner, dbtRunnerResult

class ModernDbtService:
    def __init__(self):
        self._dbt_runner = dbtRunner()

    def execute_dbt_models(self, cli_args: list[str]) -> FlextResult[dict]:
        """Execute dbt models using programmatic API."""

        try:
            result: dbtRunnerResult = self._dbt_runner.invoke(cli_args)

            return FlextResult.ok({
                "success": result.success,
                "results": result.result,
                "exception": str(result.exception) if result.exception else None
            })
        except Exception as e:
            return FlextResult.fail(f"dbt execution failed: {e}")
```

