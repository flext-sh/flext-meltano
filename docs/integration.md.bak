## 🌉 Bridge Communication

### Go ↔ Python Integration

flext-meltano provides enterprise bridge communication for Go services:

**Bridge Operations**:
```bash
# Bridge API endpoints
python scripts/flext_meltano_bridge.py version
python scripts/flext_meltano_bridge.py list_plugins
python scripts/flext_meltano_bridge.py run_pipeline tap-csv target-jsonl
python scripts/flext_meltano_bridge.py discover_catalog tap-github
python scripts/flext_meltano_bridge.py validate_project
```

**Go Integration Pattern**:
```go
package main

import (
    "encoding/json"
    "os/exec"
)

type BridgeResponse struct {
    Success bool                   `json:"success"`
    Data    map[string]interface{} `json:"data,omitempty"`
    Error   string                 `json:"error,omitempty"`
}

func RunELTPipeline(tap, target string) (*BridgeResponse, error) {
    cmd := exec.Command("python", "scripts/flext_meltano_bridge.py", "run_pipeline", tap, target)
    output, err := cmd.Output()
    if err != nil {
        return nil, err
    }

    var response BridgeResponse
    err = json.Unmarshal(output, &response)
    return &response, err
}
```

**Python Bridge Implementation**:
```python
from flext_meltano import FlextMeltanoBridge
import json
import sys

def main():
    bridge = FlextMeltanoBridge()

    if len(sys.argv) < 2:
        print(json.dumps({"success": False, "error": "No command provided"}))
        return

    command = sys.argv[1]
    args = sys.argv[2:]

    result = bridge.handle_bridge_request({
        "command": command,
        "args": args
    })

    if result.is_success:
        response = {"success": True, "data": result.unwrap()}
    else:
        response = {"success": False, "error": result.error}

    print(json.dumps(response))

if __name__ == "__main__":
    main()
```

