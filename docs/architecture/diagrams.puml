Rel(orchestrator, state_manager, "Persists", "State updates")
Rel(orchestrator, error_handler, "Handles errors", "r[T]")

Rel(plugin_manager, config_manager, "Validates", "Plugin configuration")
Rel(singer_service, state_manager, "Updates", "Singer bookmarks")
Rel(dbt_service, state_manager, "Tracks", "Model execution state")
@enduml

@startuml FLEXT-Meltano Data Flow
title FLEXT-Meltano - Data Flow Architecture

actor "Data Engineer" as user
participant "API Layer" as api
participant "Service Layer" as service
participant "Singer Tap" as tap
participant "Singer Target" as target
participant "DBT Models" as dbt
database "Source System" as source
database "Target System" as destination

user -> api: create_pipeline(tap, target)
api -> service: execute_pipeline()
service -> tap: discover_streams()
tap -> source: connect & discover schema
tap --> service: stream metadata
service -> tap: run_tap(settings, state)
tap -> source: extract data
tap --> target: stream data (JSONL)
target -> destination: load data
target --> service: state bookmarks
service -> dbt: run_transformations()
dbt -> destination: transform data
dbt --> service: transformation results
service --> api: pipeline complete
api --> user: success result
@enduml

@startuml FLEXT-Meltano Security Architecture
title FLEXT-Meltano - Security Architecture

actor "User" as user
actor "Admin" as REDACTED_LDAP_BIND_PASSWORD

rectangle "Security Boundary" as boundary {
    rectangle "API Layer" as api {
        component "Authentication" as auth
        component "Authorization" as authz
        component "Input Validation" as validation
    }

    rectangle "Service Layer" as service {
        component "Business Logic" as logic
        component "Audit Logging" as audit
    }

    rectangle "Adapter Layer" as adapter {
        component "External System Access" as external
        component "Credential Management" as creds
    }

    database "State Store" as state
}

cloud "External Systems" as external_sys {
    database "Data Sources" as sources
    database "Data Targets" as targets
    component "Meltano CLI" as meltano
    component "DBT CLI" as dbt
}

user --> auth: authenticate
auth --> authz: check permissions
authz --> validation: validate input
validation --> logic: process request
logic --> audit: log operation
logic --> adapter: execute operation
adapter --> creds: get credentials
creds --> external: access external system
external --> meltano: CLI operations
external --> dbt: transformation operations
external --> sources: data extraction
external --> targets: data loading
adapter --> state: persist state
state --> adapter: retrieve state

REDACTED_LDAP_BIND_PASSWORD --> audit: review logs
REDACTED_LDAP_BIND_PASSWORD --> authz: manage permissions
@enduml

@startuml FLEXT-Meltano Deployment Architecture
title FLEXT-Meltano - Deployment Architecture

node "Kubernetes Cluster" as k8s {
    node "FLEXT Namespace" as namespace {
        component "flext-meltano-api" as api [
            API Service
            FastAPI + Uvicorn
            Port: 8000
        ]

        component "flext-meltano-worker" as worker [
            Pipeline Worker
            Background Tasks
            Port: 8001
        ]

        database "PostgreSQL" as postgres [
            State Store
            Pipeline Metadata
            Port: 5432
        ]

        component "Redis" as redis [
            Cache & Queue
            Background Jobs
            Port: 6379
        ]
    }

    storage "Persistent Volume" as pv [
        Configuration Files
        Pipeline State
        Logs
    ]
}

cloud "External Dependencies" as external {
    component "Meltano CLI" as meltano
    component "DBT CLI" as dbt
    component "Singer SDK" as singer
}

actor "CI/CD Pipeline" as cicd

cicd --> api: Deploy application
cicd --> worker: Deploy workers
cicd --> postgres: Database migrations
cicd --> pv: Persistent storage

api --> postgres: State persistence
api --> redis: Cache operations
api --> pv: File storage
worker --> postgres: State updates
worker --> redis: Job queue
worker --> pv: Log storage

api --> meltano: CLI execution
api --> dbt: Model orchestration
api --> singer: Protocol operations

note right of api
    Horizontal scaling
    Load balancing
    Health checks
end note

note right of worker
    Auto-scaling
    Background processing
    Error recovery
end note
@enduml
