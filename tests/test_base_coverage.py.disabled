class TestFactoryFunctions:
    """Test factory functions."""

    def test_create_tap(self) -> None:
        """Test create tap factory function."""
        result = create_tap("tap-csv", {"files": []})
        assert result.is_success
        assert isinstance(result.data, FlextMeltanoTap)

    def test_create_target(self) -> None:
        """Test create target factory function."""
        result = create_target("target-csv", {"destination_path": "/tmp"})
        assert result.is_success
        assert isinstance(result.data, FlextMeltanoTarget)

    def test_create_dbt_service(self) -> None:
        """Test create DBT service factory function."""
        config = FlextMeltanoConfig()
        result = create_dbt_service(config)
        assert result.is_success
        assert isinstance(result.data, FlextMeltanoDbtService)

    def test_create_orchestration_service(self) -> None:
        """Test create orchestration service factory function."""
        config = FlextMeltanoConfig()
        result = create_orchestration_service(config)
        assert result.is_success
        assert isinstance(result.data, FlextMeltanoOrchestrationService)

    def test_create_singer_service(self) -> None:
        """Test create Singer service factory function."""
        config = FlextMeltanoConfig()
        result = create_singer_service(config)
        assert result.is_success
        assert isinstance(result.data, FlextMeltanoSingerService)


class TestIntegrationWorkflows:
    """Test integration workflows."""

    def test_complete_tap_target_workflow(self) -> None:
        """Test complete tap to target workflow."""
        # Create tap
        tap_result = create_tap("tap-csv", {
            "files": [{"entity": "users", "path": "/data/users.csv"}]
        })
        assert tap_result.is_success
        tap = tap_result.data

        # Create target
        target_result = create_target("target-csv", {
            "destination_path": "/output"
        })
        assert target_result.is_success
        target = target_result.data

        # Test discovery
        streams = tap.discover_streams()
        assert isinstance(streams, list)

        # Test schema loading
        schema = tap.load_schema("users")
        assert schema is not None

        # Test sink creation
        sink = target.get_sink("users", schema=schema)
        assert sink is not None

    def test_complete_dbt_workflow(self) -> None:
        """Test complete DBT workflow."""
        config = FlextMeltanoConfig()
        dbt_result = create_dbt_service(config)
        assert dbt_result.is_success
        dbt_service = dbt_result.data

        # Test initialization
        init_result = dbt_service.initialize()
        assert init_result.is_success

        # Test health check
        health_result = dbt_service.get_health_status()
        assert health_result.is_success

        # Test model operations
        compile_result = dbt_service.compile_project()
        assert compile_result.is_success

        execute_result = dbt_service.execute_models()
        assert execute_result.is_success

        test_result = dbt_service.test_models()
        assert test_result.is_success

    def test_complete_orchestration_workflow(self) -> None:
        """Test complete orchestration workflow."""
        config = FlextMeltanoConfig()
        orch_result = create_orchestration_service(config)
        assert orch_result.is_success
        orchestration = orch_result.data

        # Test initialization
        init_result = orchestration.initialize()
        assert init_result.is_success

        # Test health check
        health_result = orchestration.get_health_status()
        assert health_result.is_success

        # Test pipeline orchestration
        pipeline_config = {
            "name": "test-pipeline",
            "tap": "tap-csv", 
            "target": "target-csv",
            "dbt": {"models": ["staging.*"]}
        }
        pipeline_result = orchestration.orchestrate_pipeline(pipeline_config)
        assert pipeline_result.is_success

    def test_service_integration(self) -> None:
        """Test services working together."""
        config = FlextMeltanoConfig()
        
        # Create all services
        singer_result = create_singer_service(config)
        assert singer_result.is_success
        singer_service = singer_result.data

        dbt_result = create_dbt_service(config)
        assert dbt_result.is_success
        dbt_service = dbt_result.data

        orch_result = create_orchestration_service(config)
        assert orch_result.is_success
        orch_service = orch_result.data

        # Test health checks
        singer_health = singer_service.get_health_status()
        assert singer_health.is_success

        dbt_health = dbt_service.get_health_status()
        assert dbt_health.is_success

        orch_health = orch_service.get_health_status()
        assert orch_health.is_success


if __name__ == "__main__":
    pytest.main([__file__, "-v"])