"""Tests for base module to increase coverage to 90%+."""

from __future__ import annotations

import pytest

from flext_meltano.base import (
    FlextMeltanoConfig,
    FlextMeltanoDbtService,
    FlextMeltanoTapService,
    FlextMeltanoTargetService,
    FlextMeltanoExtensionService,
)


class TestFlextMeltanoConfig:
    """Test FlextMeltanoConfig functionality."""

    def test_config_initialization_default(self) -> None:
        """Test config initialization with defaults."""
        config = FlextMeltanoConfig()
        assert config is not None
        assert config.project_root is not None
        assert config.environment == "dev"

    def test_config_initialization_with_params(self) -> None:
        """Test config initialization with parameters."""
        config = FlextMeltanoConfig(
            project_root="/tmp/test",
            environment="prod",
            dbt_project_dir="/tmp/dbt"
        )
        assert config.project_root == "/tmp/test"
        assert config.environment == "prod"
        assert config.dbt_project_dir == "/tmp/dbt"

    def test_config_validation(self) -> None:
        """Test config validation."""
        config = FlextMeltanoConfig()
        assert hasattr(config, 'project_root')
        assert hasattr(config, 'environment')


# Commented out - FlextMeltanoTap class does not exist in base.py
# class TestFlextMeltanoTap:
#     """Test FlextMeltanoTap base class."""

    def test_tap_initialization(self) -> None:
        """Test tap initialization."""
        config = FlextMeltanoConfig()
        tap = FlextMeltanoTap(config={"name": "tap-csv"})
        assert tap is not None
        assert tap.name == "tap-csv"

    def test_tap_initialization_with_config_dict(self) -> None:
        """Test tap initialization with config dict."""
        config_dict = {
            "name": "tap-postgres", 
            "config": {"host": "localhost", "port": 5432}
        }
        tap = FlextMeltanoTap(config=config_dict)
        assert tap.name == "tap-postgres"

    def test_tap_discover_streams(self) -> None:
        """Test tap discover streams."""
        tap = FlextMeltanoTap(config={"name": "tap-csv"})
        streams = tap.discover_streams()
        assert isinstance(streams, list)

    def test_tap_get_records(self) -> None:
        """Test tap get records."""
        tap = FlextMeltanoTap(config={"name": "tap-csv"})
        records = list(tap.get_records("test_stream"))
        assert isinstance(records, list)

    def test_tap_load_schema(self) -> None:
        """Test tap load schema."""
        tap = FlextMeltanoTap(config={"name": "tap-csv"})
        schema = tap.load_schema("test_stream")
        assert schema is not None

    def test_tap_with_catalog(self) -> None:
        """Test tap with catalog."""
        catalog = {"streams": [{"tap_stream_id": "test"}]}
        tap = FlextMeltanoTap(config={"name": "tap-csv"}, catalog=catalog)
        assert tap.catalog == catalog

    def test_tap_with_state(self) -> None:
        """Test tap with state."""
        state = {"bookmarks": {"test": {"version": 1}}}
        tap = FlextMeltanoTap(config={"name": "tap-csv"}, state=state)
        assert tap.state == state

    def test_tap_with_parse_env_config(self) -> None:
        """Test tap with parse_env_config."""
        tap = FlextMeltanoTap(config={"name": "tap-csv"}, parse_env_config=True)
        assert tap.parse_env_config is True

    def test_tap_with_validate_config(self) -> None:
        """Test tap with validate_config."""
        tap = FlextMeltanoTap(config={"name": "tap-csv"}, validate_config=False)
        assert tap.validate_config is False


class TestFlextMeltanoTarget:
    """Test FlextMeltanoTarget base class."""

    def test_target_initialization(self) -> None:
        """Test target initialization."""
        target = FlextMeltanoTarget(config={"name": "target-csv"})
        assert target is not None
        assert target.name == "target-csv"

    def test_target_initialization_with_config_dict(self) -> None:
        """Test target initialization with config dict."""
        config_dict = {
            "name": "target-postgres",
            "config": {"host": "localhost", "port": 5432}
        }
        target = FlextMeltanoTarget(config=config_dict)
        assert target.name == "target-postgres"

    def test_target_get_sink(self) -> None:
        """Test target get sink."""
        target = FlextMeltanoTarget(config={"name": "target-csv"})
        schema = {"type": "object", "properties": {"id": {"type": "integer"}}}
        sink = target.get_sink("test_stream", schema=schema)
        assert sink is not None

    def test_target_get_sink_with_key_properties(self) -> None:
        """Test target get sink with key properties."""
        target = FlextMeltanoTarget(config={"name": "target-csv"})
        schema = {"type": "object", "properties": {"id": {"type": "integer"}}}
        sink = target.get_sink("test_stream", schema=schema, key_properties=["id"])
        assert sink is not None

    def test_target_with_config_dict(self) -> None:
        """Test target with detailed config."""
        config_dict = {
            "name": "target-csv",
            "config": {
                "destination_path": "/output",
                "file_naming_scheme": "{stream_name}.csv"
            }
        }
        target = FlextMeltanoTarget(config=config_dict)
        assert target.name == "target-csv"

    def test_target_with_validate_config(self) -> None:
        """Test target with validate_config."""
        target = FlextMeltanoTarget(config={"name": "target-csv"}, validate_config=False)
        assert target.validate_config is False


