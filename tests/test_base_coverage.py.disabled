        assert result.data["service"] == "orchestration"

    def test_orchestration_service_orchestrate_pipeline(self) -> None:
        """Test orchestration service orchestrate pipeline."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoOrchestrationService(config)
        pipeline_config = {
            "name": "test-pipeline",
            "tap": "tap-csv",
            "target": "target-csv"
        }
        result = service.orchestrate_pipeline(pipeline_config)
        assert result.is_success

    def test_orchestration_service_execute_job(self) -> None:
        """Test orchestration service execute job."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoOrchestrationService(config)
        result = service.execute_job("tap-csv", "target-csv")
        # May fail if Meltano not installed, but should not crash
        assert result.is_success or not result.is_success

    def test_orchestration_service_schedule_job(self) -> None:
        """Test orchestration service schedule job."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoOrchestrationService(config)
        schedule_config = {
            "name": "daily-sync",
            "schedule": "0 0 * * *",
            "job": "tap-csv target-csv"
        }
        result = service.schedule_job(schedule_config)
        assert result.is_success

    def test_orchestration_service_monitor_pipeline(self) -> None:
