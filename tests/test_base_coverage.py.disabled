class TestFlextMeltanoDbtService:
    """Test FlextMeltanoDbtService functionality."""

    def test_dbt_service_initialization(self) -> None:
        """Test DBT service initialization."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoDbtService(config)
        assert service is not None

    def test_dbt_service_initialization_with_project_dir(self) -> None:
        """Test DBT service initialization with project directory."""
        config = FlextMeltanoConfig(dbt_project_dir="/tmp/dbt")
        service = FlextMeltanoDbtService(config)
        assert service is not None

    def test_dbt_service_initialize(self) -> None:
        """Test DBT service initialize."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoDbtService(config)
        result = service.initialize()
        assert result.is_success

    def test_dbt_service_validate_service(self) -> None:
        """Test DBT service validation."""
        config = FlextMeltanoConfig(dbt_project_dir="/tmp/nonexistent")
        service = FlextMeltanoDbtService(config)
        result = service.validate_service()
        # Should fail for nonexistent directory
        assert not result.is_success

    def test_dbt_service_validate_service_success(self) -> None:
        """Test DBT service validation success."""
        import tempfile
        with tempfile.TemporaryDirectory() as temp_dir:
            config = FlextMeltanoConfig(dbt_project_dir=temp_dir)
            service = FlextMeltanoDbtService(config)
            result = service.validate_service()
            assert result.is_success

    def test_dbt_service_get_health_status(self) -> None:
        """Test DBT service health status."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoDbtService(config)
        result = service.get_health_status()
        assert result.is_success
        assert "service" in result.data
        assert result.data["service"] == "dbt"

    def test_dbt_service_run_dbt_command(self) -> None:
        """Test DBT service run command."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoDbtService(config)
        result = service.run_dbt_command("version")
        # May fail if DBT not installed, but should not crash
        assert result.is_success or not result.is_success

    def test_dbt_service_execute_models(self) -> None:
        """Test DBT service execute models."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoDbtService(config)
        result = service.execute_models()
        assert result.is_success

    def test_dbt_service_execute_models_with_list(self) -> None:
        """Test DBT service execute models with list."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoDbtService(config)
        result = service.execute_models(["model1", "model2"])
        assert result.is_success

    def test_dbt_service_test_models(self) -> None:
        """Test DBT service test models."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoDbtService(config)
        result = service.test_models()
        assert result.is_success

    def test_dbt_service_compile_project(self) -> None:
        """Test DBT service compile project."""
        config = FlextMeltanoConfig()
        service = FlextMeltanoDbtService(config)
        result = service.compile_project()
        assert result.is_success


class TestFlextMeltanoOrchestrationService:
