"""Comprehensive tests for real Meltano project operations.

Tests validate actual Meltano project creation, plugin installation, and management.
All tests use real meltano-core integration without mocks.
"""

from __future__ import annotations

import tempfile
from pathlib import Path

import pytest

from flext_meltano.flext_meltano_ultra_helpers import (
    flext_meltano_manage_project_ultra,
    flext_meltano_setup_project_ultra,
)


class TestFlextMeltanoProjectOperationsReal:
    """Test real Meltano project operations with actual meltano-core."""

    @pytest.fixture
    def temp_project_dir(self) -> Path:
        """Create temporary directory for project operations."""
        with tempfile.TemporaryDirectory() as tmpdir:
            yield Path(tmpdir)

    @pytest.mark.asyncio
    async def test_flext_meltano_setup_project_ultra_minimal(self, temp_project_dir: Path) -> None:
        """Test minimal project setup with default options."""
        project_path = temp_project_dir / "minimal_project"

        result = await flext_meltano_setup_project_ultra(project_path)

        # Should succeed or fail gracefully (Meltano might not be available)
        if result.success:
            # Validate project was created
            assert project_path.exists()
            assert (project_path / "meltano.yml").exists()

            # Should return project info
            data = result.data
            assert isinstance(data, dict)
            assert "project_path" in data
        else:
            # If it fails, should provide meaningful error
            assert result.error
            assert len(result.error) > 0

    @pytest.mark.asyncio
    async def test_flext_meltano_setup_project_ultra_with_plugins(self, temp_project_dir: Path) -> None:
        """Test project setup with specific plugins."""
        project_path = temp_project_dir / "plugin_project"

        result = await flext_meltano_setup_project_ultra(
            project_path,
            taps=["tap-csv"],
            targets=["target-jsonl"],
            environments=["dev", "test"],
        )

        # Should handle plugin installation
        if result.success:
            assert project_path.exists()
            data = result.data
            assert isinstance(data, dict)

            # Should contain information about installed plugins
            if "plugins" in data:
                plugins = data["plugins"]
                assert isinstance(plugins, dict)
        else:
            # Should provide meaningful error for why setup failed
            assert result.error

    @pytest.mark.asyncio
    async def test_flext_meltano_manage_project_ultra_status(self, temp_project_dir: Path) -> None:
        """Test project status management."""
        project_path = temp_project_dir / "status_project"

        # First create a project
        setup_result = await flext_meltano_setup_project_ultra(project_path)

        if setup_result.success:
            # Then check status
            status_result = await flext_meltano_manage_project_ultra(
                project_path,
                action="status",
            )

            # Should return status information
            if status_result.success:
                data = status_result.data
                assert isinstance(data, dict)
            else:
                # Status check can fail if project is not properly initialized
                assert status_result.error

    @pytest.mark.asyncio
    async def test_flext_meltano_manage_project_ultra_plugins(self, temp_project_dir: Path) -> None:
        """Test project plugin listing."""
        project_path = temp_project_dir / "plugins_project"

        # First create a project
        setup_result = await flext_meltano_setup_project_ultra(project_path)

        if setup_result.success:
            # Then list plugins
            plugins_result = await flext_meltano_manage_project_ultra(
                project_path,
                action="plugins",
            )

            # Should return plugin information
            if plugins_result.success:
                data = plugins_result.data
                assert isinstance(data, dict)
                # Should have extractors and loaders structure
                if "extractors" in data and "loaders" in data:
                    assert isinstance(data["extractors"], list)
                    assert isinstance(data["loaders"], list)
            else:
                # Plugin listing can fail if project is not properly initialized
                assert plugins_result.error

    @pytest.mark.asyncio
    async def test_flext_meltano_setup_project_ultra_invalid_path(self) -> None:
        """Test project setup with invalid path."""
        # Try to create project in a restricted location
        invalid_path = Path("/root/invalid_project")

        result = await flext_meltano_setup_project_ultra(invalid_path)

        # Should fail gracefully
        assert not result.success
        assert result.error
        assert len(result.error) > 0

    @pytest.mark.asyncio
    async def test_flext_meltano_manage_project_ultra_nonexistent(self, temp_project_dir: Path) -> None:
        """Test managing nonexistent project."""
        nonexistent_path = temp_project_dir / "nonexistent_project"

        result = await flext_meltano_manage_project_ultra(
            nonexistent_path,
            action="status",
        )

        # Should fail gracefully
        assert not result.success
        assert result.error


class TestFlextMeltanoProjectOperationsIntegration:
    """Integration tests for complex project scenarios."""

    @pytest.fixture
    def temp_project_dir(self) -> Path:
        """Create temporary directory for project operations."""
        with tempfile.TemporaryDirectory() as tmpdir:
            yield Path(tmpdir)

    @pytest.mark.asyncio
    async def test_flext_meltano_complete_project_workflow(self, temp_project_dir: Path) -> None:
        """Test complete project workflow from creation to management."""
        project_path = temp_project_dir / "workflow_project"

        # Step 1: Create project
        setup_result = await flext_meltano_setup_project_ultra(
            project_path,
            taps=["tap-csv"],
            targets=["target-csv"],
            environments=["dev"],
        )

        # Step 2: If creation succeeded, test management operations
        if setup_result.success:
            # Check status
            status_result = await flext_meltano_manage_project_ultra(
                project_path,
                action="status",
            )

            # List plugins
            plugins_result = await flext_meltano_manage_project_ultra(
                project_path,
                action="plugins",
            )

            # At least one operation should succeed
            operations_succeeded = any([
                status_result.success,
                plugins_result.success,
            ])

            # If no operations succeeded, at least they should fail gracefully
            if not operations_succeeded:
                assert all([
                    status_result.error,
                    plugins_result.error,
                ])

    @pytest.mark.asyncio
    async def test_flext_meltano_project_with_multiple_environments(self, temp_project_dir: Path) -> None:
        """Test project creation with multiple environments."""
        project_path = temp_project_dir / "multi_env_project"

        result = await flext_meltano_setup_project_ultra(
            project_path,
            environments=["dev", "staging", "prod"],
        )

        # Should handle multiple environments
        if result.success:
            data = result.data
            assert isinstance(data, dict)

            # Should contain environment information
            if "environments" in data:
                environments = data["environments"]
                assert isinstance(environments, list)
                # Should contain at least the environments we specified
                env_names = [env.get("name") if isinstance(env, dict) else str(env) for env in environments]
                expected_envs = {"dev", "staging", "prod"}
                created_envs = set(env_names)
                # At least some of the environments should be created
                assert len(expected_envs.intersection(created_envs)) > 0


if __name__ == "__main__":
    pytest.main([__file__, "-v", "--tb=short"])
