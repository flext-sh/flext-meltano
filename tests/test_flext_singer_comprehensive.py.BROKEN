        result = flext_singer_process_stream(messages)
        assert result.is_success


class TestFlextSingerIntegration:
    """Integration tests for FlextSinger components."""

    def test_end_to_end_processing(self):
        """Test complete end-to-end message processing."""
        # Create components
        bridge = FlextSingerBridge()
        handler = FlextSingerMessageHandler()
        processor = FlextSingerProcessor()

        # Create messages using bridge
        schema_result = bridge.flext_singer_create_message(
            "SCHEMA",
            stream="users",
            schema={"type": "object", "properties": {"id": {"type": "integer"}}},
            key_properties=["id"],
        )
        assert schema_result.is_success

        record_result = bridge.flext_singer_create_message(
            "RECORD",
            stream="users",
            record={"id": 1, "name": "test"},
        )
        assert record_result.is_success

        # Process messages through handler
        schema_handle = handler.handle_message(schema_result.data)
        record_handle = handler.handle_message(record_result.data)

        assert schema_handle.is_success
        assert record_handle.is_success

        # Get final statistics
        stats = handler.get_statistics()
        assert stats.is_success
        assert stats.data["records_processed"] >= 1
        assert stats.data["schemas_processed"] >= 1

    def test_error_handling_integration(self):
        """Test error handling across components."""
        bridge = FlextSingerBridge()
        handler = FlextSingerMessageHandler()

        # Test invalid message creation
        invalid_result = bridge.flext_singer_create_message("INVALID_TYPE")
        assert not invalid_result.is_success

        # Test invalid message handling
        invalid_handle = handler.handle_message({"type": "INVALID"})
        assert not invalid_handle.is_success

    def test_performance_with_large_dataset(self):
        """Test performance with larger dataset."""
        processor = FlextSingerProcessor()

        # Create large number of messages
        messages = []
        for i in range(100):
            messages.append(f'{{"type": "RECORD", "stream": "test", "record": {{"id": {i}}}}}')

        result = processor.process_messages(messages)
        assert result.is_success
        assert result.data["messages_processed"] == 100

    def test_mixed_message_types_processing(self):
        """Test processing mixed message types in realistic order."""
        processor = FlextSingerProcessor()

        messages = [
            # Schema first
            '{"type": "SCHEMA", "stream": "orders", "schema": {"type": "object"}, "key_properties": ["id"]}',
            # Multiple records
            '{"type": "RECORD", "stream": "orders", "record": {"id": 1, "amount": 100.0}}',
            '{"type": "RECORD", "stream": "orders", "record": {"id": 2, "amount": 250.0}}',
            '{"type": "RECORD", "stream": "orders", "record": {"id": 3, "amount": 75.5}}',
            # State update
            '{"type": "STATE", "value": {"bookmarks": {"orders": {"last_id": 3}}}}',
            # More records
            '{"type": "RECORD", "stream": "orders", "record": {"id": 4, "amount": 300.0}}',
            # Final state
            '{"type": "STATE", "value": {"bookmarks": {"orders": {"last_id": 4}}}}',
        ]

        result = processor.process_messages(messages)
        assert result.is_success
        assert result.data["messages_processed"] == 7


if __name__ == "__main__":
    pytest.main([__file__, "-v"])
