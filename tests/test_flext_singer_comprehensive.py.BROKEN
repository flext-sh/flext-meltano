"""Comprehensive tests for FlextSinger module.

Tests all functionality in flext_singer.py to achieve high coverage.
"""

from __future__ import annotations

from io import StringIO

import pytest

from flext_meltano.flext_singer import (
    FlextSingerBridge,
)


class TestFlextSingerBridge:
    """Test FlextSinger bridge functionality."""

    def test_bridge_initialization(self):
        """Test bridge initialization."""
        bridge = FlextSingerBridge()
        assert bridge is not None
        assert hasattr(bridge, "_logger")
        assert hasattr(bridge, "_container")
        assert hasattr(bridge, "_message_types")

    def test_create_record_message(self):
        """Test creating RECORD message."""
        bridge = FlextSingerBridge()
        result = bridge.flext_singer_create_message(
            "RECORD",
            stream="users",
            record={"id": 1, "name": "test"},
            time_extracted="2025-01-01T00:00:00Z",
        )
        assert result.is_success
        assert result.data["type"] == "RECORD"
        assert result.data["stream"] == "users"
        assert result.data["record"] == {"id": 1, "name": "test"}

    def test_create_schema_message(self):
        """Test creating SCHEMA message."""
        bridge = FlextSingerBridge()
        schema = {
            "type": "object",
            "properties": {
                "id": {"type": "integer"},
                "name": {"type": "string"},
            },
        }
        result = bridge.flext_singer_create_message(
            "SCHEMA",
            stream="users",
            schema=schema,
            key_properties=["id"],
        )
        assert result.is_success
        assert result.data["type"] == "SCHEMA"
        assert result.data["stream"] == "users"
        assert result.data["schema"] == schema

    def test_create_state_message(self):
        """Test creating STATE message."""
        bridge = FlextSingerBridge()
        state = {"bookmarks": {"users": {"last_updated": "2025-01-01T00:00:00Z"}}}
        result = bridge.flext_singer_create_message(
            "STATE",
            value=state,
        )
        assert result.is_success
        assert result.data["type"] == "STATE"
        assert result.data["value"] == state

    def test_create_unknown_message_type(self):
        """Test creating unknown message type."""
        bridge = FlextSingerBridge()
        result = bridge.flext_singer_create_message("UNKNOWN")
        assert not result.is_success
        assert "Unknown message type" in result.error

    def test_specific_create_record_message(self):
        """Test specific record message creation method."""
        bridge = FlextSingerBridge()
        result = bridge.flext_singer_create_record_message(
            stream="test",
            record={"id": 1},
        )
        assert result.is_success
        assert result.data["type"] == "RECORD"

    def test_specific_create_schema_message(self):
        """Test specific schema message creation method."""
        bridge = FlextSingerBridge()
        result = bridge.flext_singer_create_schema_message(
            stream="test",
            schema={"type": "object", "properties": {"id": {"type": "integer"}}},
            key_properties=["id"],
        )
        assert result.is_success
        assert result.data["type"] == "SCHEMA"

    def test_specific_create_state_message(self):
        """Test specific state message creation method."""
        bridge = FlextSingerBridge()
        result = bridge.flext_singer_create_state_message(
            value={"bookmark": "test"},
        )
        assert result.is_success
        assert result.data["type"] == "STATE"

    def test_parse_message_line(self):
        """Test parsing message line."""
        bridge = FlextSingerBridge()
        message_line = '{"type": "RECORD", "stream": "test", "record": {"id": 1}}'
        result = bridge.flext_singer_parse_message_line(message_line)
        assert result.is_success
        assert result.data["type"] == "RECORD"

    def test_parse_empty_line(self):
        """Test parsing empty line."""
        bridge = FlextSingerBridge()
        result = bridge.flext_singer_parse_message_line("")
        assert not result.is_success
        assert "Empty message line" in result.error

    def test_parse_invalid_json(self):
        """Test parsing invalid JSON."""
        bridge = FlextSingerBridge()
        result = bridge.flext_singer_parse_message_line("invalid json")
        assert not result.is_success
        assert "Invalid JSON" in result.error

    def test_validate_record_message(self):
        """Test validating RECORD message."""
        bridge = FlextSingerBridge()
        message = {"type": "RECORD", "stream": "test", "record": {"id": 1}}
        result = bridge.flext_singer_validate_message(message)
        assert result.is_success
        assert result.data == "RECORD"

    def test_validate_schema_message(self):
        """Test validating SCHEMA message."""
        bridge = FlextSingerBridge()
        message = {
            "type": "SCHEMA",
            "stream": "test",
            "schema": {"type": "object"},
        }
        result = bridge.flext_singer_validate_message(message)
        assert result.is_success
        assert result.data == "SCHEMA"

    def test_validate_state_message(self):
        """Test validating STATE message."""
        bridge = FlextSingerBridge()
        message = {"type": "STATE", "value": {"bookmark": "test"}}
        result = bridge.flext_singer_validate_message(message)
        assert result.is_success
        assert result.data == "STATE"

    def test_validate_message_without_type(self):
        """Test validating message without type field."""
        bridge = FlextSingerBridge()
        message = {"stream": "test", "record": {"id": 1}}
        result = bridge.flext_singer_validate_message(message)
        assert not result.is_success
        assert "type" in result.error

    def test_validate_record_message_missing_stream(self):
        """Test validating RECORD message missing stream."""
        bridge = FlextSingerBridge()
        message = {"type": "RECORD", "record": {"id": 1}}
        result = bridge.flext_singer_validate_message(message)
        assert not result.is_success
        assert "stream" in result.error

    def test_validate_unknown_message_type(self):
        """Test validating unknown message type."""
        bridge = FlextSingerBridge()
        message = {"type": "UNKNOWN"}
        result = bridge.flext_singer_validate_message(message)
        assert not result.is_success
        assert "Unknown message type" in result.error

    def test_write_message(self):
        """Test writing message to stdout."""
        bridge = FlextSingerBridge()
        message = {"type": "RECORD", "stream": "test", "record": {"id": 1}}
        result = bridge.flext_singer_write_message(message)
        assert result.is_success

    def test_write_invalid_message(self):
        """Test writing invalid message."""
        bridge = FlextSingerBridge()
        message = {"type": "RECORD"}  # Missing required fields
        result = bridge.flext_singer_write_message(message)
        assert not result.is_success

    def test_read_messages_from_string_io(self):
        """Test reading messages from StringIO."""
        bridge = FlextSingerBridge()
        input_data = StringIO('{"type": "RECORD", "stream": "test", "record": {"id": 1}}\n')

        messages = list(bridge.flext_singer_read_messages(input_data))
        assert len(messages) == 1
        assert messages[0].is_success
        assert messages[0].data["type"] == "RECORD"

    def test_create_record_message_invalid_inputs(self):
        """Test creating record message with invalid inputs."""
        bridge = FlextSingerBridge()

        # Empty stream
        result = bridge.flext_singer_create_record_message("", {"id": 1})
        assert not result.is_success

        # Invalid record type
        result = bridge.flext_singer_create_record_message("test", "not a dict")
        assert not result.is_success

    def test_create_schema_message_invalid_inputs(self):
        """Test creating schema message with invalid inputs."""
        bridge = FlextSingerBridge()

        # Empty stream
        result = bridge.flext_singer_create_schema_message("", {"type": "object"})
        assert not result.is_success

        # Invalid schema type
        result = bridge.flext_singer_create_schema_message("test", "not a dict")
        assert not result.is_success

    def test_create_state_message_invalid_input(self):
        """Test creating state message with invalid input."""
        bridge = FlextSingerBridge()

        # Invalid value type
        result = bridge.flext_singer_create_state_message("not a dict")
        assert not result.is_success


class TestFlextSingerMessageHandler:
    """Test FlextSinger message handler."""

    def test_handler_initialization(self):
        """Test handler initialization."""
        handler = FlextSingerMessageHandler()
        assert handler is not None
        assert hasattr(handler, "_logger")

    def test_handle_record_message(self):
        """Test handling RECORD message."""
        handler = FlextSingerMessageHandler()
        message = {"type": "RECORD", "stream": "test", "record": {"id": 1}}
        result = handler.handle_message(message)
        assert result.is_success

    def test_handle_schema_message(self):
        """Test handling SCHEMA message."""
        handler = FlextSingerMessageHandler()
        message = {
            "type": "SCHEMA",
            "stream": "test",
            "schema": {"type": "object", "properties": {"id": {"type": "integer"}}},
            "key_properties": ["id"],
        }
        result = handler.handle_message(message)
        assert result.is_success

    def test_handle_state_message(self):
        """Test handling STATE message."""
        handler = FlextSingerMessageHandler()
        message = {"type": "STATE", "value": {"bookmark": "test"}}
        result = handler.handle_message(message)
        assert result.is_success

    def test_handle_unknown_message(self):
        """Test handling unknown message type."""
        handler = FlextSingerMessageHandler()
        message = {"type": "UNKNOWN"}
        result = handler.handle_message(message)
        assert not result.is_success
        assert "Unknown message type" in result.error

    def test_handler_statistics(self):
        """Test handler statistics tracking."""
        handler = FlextSingerMessageHandler()

        # Process some messages
        handler.handle_message({"type": "RECORD", "stream": "test", "record": {"id": 1}})
        handler.handle_message({"type": "SCHEMA", "stream": "test", "schema": {}, "key_properties": []})
        handler.handle_message({"type": "STATE", "value": {}})

        stats = handler.get_statistics()
        assert stats.is_success
        assert "records_processed" in stats.data
        assert "schemas_processed" in stats.data
        assert "states_processed" in stats.data


class TestFlextSingerProcessor:
    """Test FlextSinger processor."""

    def test_processor_initialization(self):
        """Test processor initialization."""
        processor = FlextSingerProcessor()
        assert processor is not None
        assert hasattr(processor, "_logger")
        assert hasattr(processor, "_handler")

    def test_process_stream_with_messages(self):
        """Test processing stream with multiple message types."""
        processor = FlextSingerProcessor()

        messages = [
            '{"type": "SCHEMA", "stream": "users", "schema": {"type": "object"}, "key_properties": ["id"]}',
            '{"type": "RECORD", "stream": "users", "record": {"id": 1, "name": "Alice"}}',
            '{"type": "RECORD", "stream": "users", "record": {"id": 2, "name": "Bob"}}',
            '{"type": "STATE", "value": {"bookmark": "2025-01-01T00:00:00Z"}}',
        ]

        result = processor.process_messages(messages)
        assert result.is_success
        assert result.data["messages_processed"] == 4

    def test_process_empty_stream(self):
        """Test processing empty stream."""
        processor = FlextSingerProcessor()
        result = processor.process_messages([])
        assert result.is_success
        assert result.data["messages_processed"] == 0

    def test_process_stream_with_invalid_message(self):
        """Test processing stream with invalid message."""
        processor = FlextSingerProcessor()
        messages = [
            '{"type": "RECORD", "stream": "test", "record": {"id": 1}}',
            "invalid json line",
            '{"type": "STATE", "value": {}}',
        ]
        result = processor.process_messages(messages)
        # Should continue processing despite invalid message
        assert result.is_success
        assert result.data["messages_processed"] == 2  # Only valid messages

    def test_processor_reset(self):
        """Test processor reset functionality."""
        processor = FlextSingerProcessor()

        # Process some messages
        messages = ['{"type": "RECORD", "stream": "test", "record": {"id": 1}}']
        processor.process_messages(messages)

        # Reset processor
        result = processor.reset()
        assert result.is_success

        # Statistics should be reset
        stats = processor.get_statistics()
        assert stats.data["messages_processed"] == 0


