                description=\"Root directory for pipeline configurations\",\n            ),\n        ] = \"\"\n\n        @m.field_validator(\"pipelines_dir\", mode=\"before\")\n        @classmethod\n        def _coerce_pipelines_dir(cls, value: str | None) -> str:\n            text = value.strip() if value is not None else \"\"\n            if text:\n                return str(Path(text).expanduser().resolve())\n            return str((Path.cwd() / \".flext-meltano\" / \"pipelines\").resolve())\n\n        @m.field_validator(\"project_root\", mode=\"before\")\n        @classmethod\n        def _coerce_project_root(cls, value: str | None) -> str:\n            return str(Path(value).resolve()) if value else \"\"\n\n        @m.field_validator(\"config_dir\", \"logs_dir\", mode=\"before\")\n        @classmethod\n        def _coerce_path(cls, value: str | None) -> str:\n            return value or \"\"\n\n        @m.field_validator(\"environment\")\n        @classmethod\n        def _validate_environment(cls, value: str) -> str:\n            normalized = value.strip().lower()\n            aliased = FlextMeltanoSettings.ENVIRONMENT_ALIASES.get(normalized)\n            if aliased is not None:\n                return aliased\n            if normalized in FlextMeltanoSettings.SETTINGS_ENVIRONMENTS:\n                return normalized\n            allowed = \", \".join(FlextMeltanoSettings.SETTINGS_ENVIRONMENTS)\n            msg = f\"Environment must be one of: {allowed}\"\n            raise ValueError(msg)\n\n    if TYPE_CHECKING:\n        # The assigned per-field defaults above make the namespace constructible\n        # for the checkers; runtime keeps the pydantic-recommended factory.\n        Meltano: _Meltano = m.Field(\n            default=_Meltano(),\n            description=\"Namespaced Meltano settings.\",\n        )\n    else:\n        Meltano: _Meltano = m.Field(\n            default_factory=_Meltano,\n            description=\"Namespaced Meltano settings.\",\n        )\n\n\nsettings: FlextMeltanoSettings = FlextMeltanoSettings.fetch_global()\n\"\"\"Pre-instantiated project settings singleton.\n\n``from flext_meltano import settings``.\n\"\"\"\n\n__all__: list[str] = [\"FlextMeltanoSettings\", \"settings\"]\n","range":{"byteOffset":{"start":0,"end":5328},"start":{"line":0,"column":0},"end":{"line":149,"column":0}}}]},"transformed":{}},"ruleId":"import-header--foreign-origin--flext_meltano--statement","severity":"hint","note":null,"message":"Outside the families, `flext_meltano` binds every letter from its own root, never from another package."}
